# Copy this file to .env.runtime. Never commit the populated file; set permissions to 600.
# These two public build-time values are embedded in the browser bundle.
VITE_APP_ID=replace-with-public-application-id
VITE_OAUTH_PORTAL_URL=https://replace-with-approved-oauth-portal

# Required server-only production configuration.
# Use the EXISTING JWT_SECRET if connecting to the existing NSOS database.
# A replacement key cannot decrypt provider credentials, Meta tokens or bank details encrypted by the previous key.
# JWT_SECRET is deliberately omitted and must be exported by the invoking shell or injected by a secure secret manager.
# Never place JWT_SECRET in this file.
DATABASE_URL=mysql://user:password@db-host:3306/nsos
OAUTH_SERVER_URL=https://replace-with-approved-oauth-server

# Optional deployment settings.
NSOS_HOST_PORT=3000
OWNER_OPEN_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPOSIO_TOOL_VERSION=
