# NSOS environment template. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Core application/auth
VITE_APP_ID=replace-with-app-id
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.example.com
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@localhost:3306/nsos
OAUTH_SERVER_URL=https://your-oauth-provider.example.com
OWNER_OPEN_ID=replace-with-owner-open-id

# Built-in platform services (leave blank when unused)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google OAuth (optional unless enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (optional for local development)
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@example.com

# Safe staging-only synthetic load probe
NSOS_LOAD_TEST_APPROVED=false
NSOS_STAGING_AUDIT_URL=
NSOS_LOAD_TEST_REQUESTS=50
NSOS_LOAD_TEST_CONCURRENCY=10


# Standalone NSOS deployment
PUBLIC_APP_URL=https://nsos.top
AUTH_ALLOWED_ORIGINS=
LEGACY_MANUS_AUTH_ENABLED=true
VITE_LEGACY_LOGIN_ENABLED=true

# Independent OpenAI-compatible LLM provider (for example, Gemini)
LLM_PROVIDER=forge
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# S3-compatible object storage
STORAGE_PROVIDER=forge
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Google Maps keys: use separate server and referrer-restricted browser keys
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional owner notifications
OWNER_NOTIFICATION_EMAIL=
