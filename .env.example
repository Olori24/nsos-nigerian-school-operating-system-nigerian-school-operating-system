# NSOS environment template. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Core application/auth
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@localhost:3306/nsos
OWNER_OPEN_ID=replace-with-owner-open-id

# Canonical NSOS authentication origin
AUTH_CANONICAL_ORIGIN=https://nsos.top

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI (chat, image generation and voice transcription)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# S3-compatible object storage (Cloudflare R2 or AWS S3)
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Temporary read-only access to pre-migration Manus Forge objects.
# Remove after the legacy-object migration has been verified complete.
LEGACY_STORAGE_FORGE_API_URL=
LEGACY_STORAGE_FORGE_API_KEY=

# OpenStreetMap service identity
MAPS_USER_AGENT=NSOS/1.0 (https://nsos.top)

# Transactional email and owner notifications
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@example.com
OWNER_NOTIFICATION_EMAIL=

# Scheduled jobs
CRON_SECRET=

# Safe staging-only synthetic load probe
NSOS_LOAD_TEST_APPROVED=false
NSOS_STAGING_AUDIT_URL=
NSOS_LOAD_TEST_REQUESTS=50
NSOS_LOAD_TEST_CONCURRENCY=10
